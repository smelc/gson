module(
    name = "gson",
    version = "1.0.0",
    bazel_compatibility = [">=8.3.0"],
)

# Causes bazel-bin/external/rules_java+ to be created
# >=8.15.2 is required to have support for local JVMs ("java.local" below)
bazel_dep(name = "rules_java", version = "8.15.2")

java = use_extension("@rules_java//java:extensions.bzl", "java_repository")

bazel_dep(name = "rules_jvm_external", version = "6.8")
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
# Run `REPIN=1 bazel run @maven//:pin` to repin
maven.install(
    artifacts = [
        "com.google.errorprone:error_prone_annotations:2.41.0",
        "junit:junit:4.13.2",
        "com.google.truth:truth:1.4.2",
        "com.google.guava:guava-testlib:33.4.8-jre",
        "com.google.guava:guava:33.4.8-jre",
        "com.fasterxml.jackson.core:jackson-databind:2.19.2",
        "com.google.caliper:caliper:1.0-beta-3",
    ],
    lock_file = "//:maven_install.json",
)
use_repo(maven, "maven")
